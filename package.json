{
  "name": "sweetwo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@sweetwo/web --filter=@sweetwo/admin",
    "dev:desktop": "turbo run dev --filter=@sweetwo/desktop",
    "dev:site": "turbo run dev --filter=@sweetwo/site",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "format": "prettier --write .",
    "ds:sync": "node scripts/ds-sync.mjs",
    "content:sync": "node scripts/content-sync.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public | prettier --no-config --parser typescript --no-semi --print-width 100 > packages/core/src/db.types.ts",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
