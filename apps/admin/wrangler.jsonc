// Cloudflare Workers 정적 자산 배포(개발 서버, ADR 0002). 대시보드 Worker 이름과 같아야 함
// 빌드는 저장소 루트에서 pnpm --filter, 배포는 npx wrangler deploy --config apps/admin/wrangler.jsonc
{
  "name": "sweetwo-admin",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
