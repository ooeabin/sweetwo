---
// L-02 앱 받기(/download, 2026-11-10 설치 안내 대신, ADR 0008): 기기에 맞는 스토어 버튼(Download와 같은 규칙).
// 앱의 강제 업데이트(A-01 ‘지금 업데이트’)와 알림 메일 링크(‘앱 받기’)가 이 페이지로 옴. 예전 ?os= 값은 무시.
import Download from '../components/Download.astro';
import Site from '../layouts/Site.astro';
import { t } from '../lib/site';
---
<Site title={t.title(t.getApp)} description={t.getApp}>
  <section class="hg-site__sec" style="border-top: 0;">
    <h1 class="hg-site__h2">{t.getApp}</h1>
    <Download placement="install" />
  </section>
</Site>
