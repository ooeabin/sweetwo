---
// 초대 링크 화면(28 공통 ‘초대 링크’). /i/{코드}는 public/_redirects가 /i/ 페이지를 200으로 보여 줌(주소는 그대로, 2026-11-12).
// 404 페이지도 /i/로 시작하는 주소면 같은 화면을 보여 줌(되돌림 장치: _redirects를 모르는 미리보기 서버 등).
// 앱이 깔린 휴대폰은 앱 링크로 앱이 바로 열려 이 화면을 보지 않음.
// - 앱이 없는 휴대폰: “sweeTwo에 초대받았어요” + 코드(크게, ‘복사’) + 그 기기 스토어 버튼
// - PC: 같은 초대 화면 + 스토어 버튼 2개(2026-11-10 데스크톱 앱과 ‘앱으로 열까요?’ 없앰, ADR 0008)
// - 코드 없이 /i/: 제목 + “앱을 설치한 뒤 받은 초대 코드를 입력해 주세요” + 스토어 버튼(코드 줄 없음)
// - 2026-11-13 L-07(28, PR 13): 코드가 있으면 휴대폰 주 버튼을 “앱 받고 합류하기”로. 누르면 코드를 클립보드에 복사하고
//   (실패해도 그대로) 스토어로. Google Play 링크에는 설치 리퍼러 referrer=invite_{코드}(앱이 첫 실행에 읽음, 15 O-01)
// 코드가 유효한지는 확인하지 않음(로그인 없이 검증하지 않음, 만료·사용은 앱 P-01 규칙)
import Download from './Download.astro';
import { t } from '../lib/site';
interface Props {
  /** /i/ 페이지는 늘 보임. 404 페이지는 /i/로 시작하는 주소일 때만 */
  always?: boolean;
}
const { always = false } = Astro.props;
---

<div data-invite hidden={!always}>
  <section class="hg-site__sec" style="border-top: 0;">
    <h1 class="hg-site__h2">{t.invited}</h1>
    <p class="hg-site__lead" data-invite-sub>{t.invitedNoCode}</p>
    <div class="hg-row" style="gap: var(--space-3); align-items: center;" data-code-row hidden>
      <b class="hg-site__h2" style="letter-spacing: var(--space-1);" data-code></b>
      <button type="button" class="hg-btn hg-btn--secondary hg-btn--sm" data-copy>{t.copyCode}</button>
      <span class="hg-help" role="status" data-copied></span>
    </div>
    <Download placement="invite" />
  </section>
</div>
<script>
  import { t } from '../lib/site';
  const isInvite = location.pathname.startsWith('/i/');
  const code = (location.pathname.split('/i/')[1] ?? '').replace(/[^A-Za-z0-9]/g, '').slice(0, 12);
  const box = document.querySelector<HTMLElement>('[data-invite]');
  if (isInvite && box) {
    box.hidden = false;
    if (code) {
      const sub = document.querySelector<HTMLElement>('[data-invite-sub]');
      if (sub) sub.textContent = t.invitedSub;
      const row = document.querySelector<HTMLElement>('[data-code-row]');
      if (row) row.hidden = false;
      const c = document.querySelector<HTMLElement>('[data-code]');
      if (c) c.textContent = code;
      // 스토어 버튼: 코드 복사(iOS는 앱이 첫 실행에 클립보드를 한 번 읽음) + Play 링크에 설치 리퍼러
      box.querySelectorAll<HTMLAnchorElement>('a[data-store]').forEach((a) => {
        if (a.dataset.store === 'google_play') {
          try {
            const u = new URL(a.href);
            u.searchParams.set('referrer', `invite_${code}`);
            a.href = u.toString();
          } catch {
            /* 그대로 */
          }
        }
        const label = a.lastChild;
        if (a.classList.contains('hg-btn--primary') && label) label.textContent = t.getAndJoin;
        a.addEventListener('click', () => {
          void navigator.clipboard?.writeText(code).catch(() => undefined);
        });
      });
      document.querySelector('[data-copy]')?.addEventListener('click', () => {
        void navigator.clipboard?.writeText(code).then(() => {
          const s = document.querySelector<HTMLElement>('[data-copied]');
          if (s) s.textContent = t.copied;
        });
      });
    }
  }
</script>
