---
// 초대 링크 화면(28 공통 ‘초대 링크’). /i/{코드}는 정적 파일이 없어 404 페이지와 /i/가 이 컴포넌트를 씀.
// 앱이 깔린 휴대폰은 앱 링크로 앱이 바로 열려 이 화면을 보지 않음.
// - 앱이 없는 휴대폰: “sweeTwo에 초대받았어요” + 코드(크게, ‘복사’) + 그 기기 스토어 버튼
// - PC: 같은 초대 화면 + 스토어 버튼 2개(2026-11-10 데스크톱 앱과 ‘앱으로 열까요?’ 없앰, ADR 0008)
// 코드가 유효한지는 확인하지 않음(로그인 없이 검증하지 않음, 만료·사용은 앱 P-01 규칙)
import Download from './Download.astro';
import { t } from '../lib/site';
---

<div data-invite hidden>
  <section class="hg-site__sec" style="border-top: 0;">
    <h1 class="hg-site__h2">{t.invited}</h1>
    <p class="hg-site__lead">{t.invitedSub}</p>
    <div class="hg-row" style="gap: var(--space-3); align-items: center;">
      <b class="hg-site__h2" style="letter-spacing: var(--space-1);" data-code></b>
      <button type="button" class="hg-btn hg-btn--secondary hg-btn--sm" data-copy>{t.copyCode}</button>
      <span class="hg-help" role="status" data-copied></span>
    </div>
    <Download placement="invite" />
  </section>
</div>
<script>
  import { t } from '../lib/site';
  const isInvite = location.pathname.startsWith('/i/');
  const code = (location.pathname.split('/i/')[1] ?? '').replace(/[^A-Za-z0-9]/g, '').slice(0, 12);
  const box = document.querySelector<HTMLElement>('[data-invite]');
  if (isInvite && code && box) {
    box.hidden = false;
    const c = document.querySelector<HTMLElement>('[data-code]');
    if (c) c.textContent = code;
    document.querySelector('[data-copy]')?.addEventListener('click', () => {
      void navigator.clipboard?.writeText(code).then(() => {
        const s = document.querySelector<HTMLElement>('[data-copied]');
        if (s) s.textContent = t.copied;
      });
    });
  }
</script>
