---
// 웹사이트 틀(docs/design/components/SiteLayout.md): 상단 바, 본문, 하단. 앱 메뉴 줄 없이 같은 토큰과 hg- 클래스.
import logo from '../../../../packages/ui/src/assets/brand/logo-cherry.svg';
import '../styles.css';
import { URLS, t } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** 하단 다운로드처럼 페이지가 고유 스크립트를 쓰면 */
  bare?: boolean;
  /** 검색에 안 내보내는 페이지(초대, 없는 주소, 로그인 복귀, 알림 메일 링크): noindex, canonical·og:url 없음 */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const og = new URL('/og.png', Astro.site).toString();
// 28 공통(2026-11-12): 페이지마다 canonical·og:url = sweetwo.kr + 경로(쿼리 없음). 미리보기·개발 주소도 운영 주소로
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// 사업자 정보는 값이 정해진 줄만(출시 준비 34 4장, 정하기 전에는 하단에 안 보임, 2026-11-12)
const business = t.foot.business.filter(([, v]) => v.trim() !== '');
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- 다크 모드는 기기 설정(28 공통 ‘디자인’). 토큰이 [data-theme]로 바꾸므로 그리기 전에 붙임(어드민 main.tsx와 같은 방식) -->
    <script is:inline>
      (() => {
        const q = window.matchMedia('(prefers-color-scheme: dark)');
        const set = () => (document.documentElement.dataset.theme = q.matches ? 'dark' : 'light');
        set();
        q.addEventListener('change', set);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sweeTwo" />
    <meta property="og:locale" content="ko_KR" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body class="hg-root hg-site">
    <header class="hg-site__wrap">
      <nav class="hg-site__bar" aria-label="sweeTwo">
        <a href="/" class="hg-wordmark" aria-label="sweeTwo 처음으로"><img src={logo.src} alt="sweeTwo" height="32" /></a>
        <a class="hg-btn hg-btn--ghost hg-site__faq" href="/help">{t.faq}</a>
        <!-- 앱 받기(L-01 1번): PC는 맨 아래 다운로드로, 휴대폰은 그 기기 스토어(lib/client.ts가 주소를 바꿈) -->
        <a class="hg-btn hg-btn--secondary hg-btn--sm" href="/#get" data-get-app data-placement="top">{t.getApp}</a>
      </nav>
    </header>
    <main class="hg-site__wrap">
      <slot />
    </main>
    <footer class="hg-site__wrap">
      <div class="hg-site__foot">
        <div class="hg-site__links">
          <a href="/terms">{t.foot.terms}</a>
          <a href="/privacy" class="is-strong">{t.foot.privacy}</a>
          <a href="/help">{t.foot.help}</a>
          <a href={URLS.status} rel="noopener">{t.foot.status}</a>
        </div>
        <p><a href={URLS.help}>{t.foot.contact}</a></p>
        <p><a href={URLS.privacyMail}>{t.foot.privacyOfficer}</a></p>
        {business.length > 0 && <p>{business.map(([k, v]) => <span class="hg-meta">{k} {v} </span>)}</p>}
        <p>{t.foot.notAdvice}</p>
      </div>
    </footer>
    <script>
      import { boot } from '../lib/client';
      boot();
    </script>
  </body>
</html>
