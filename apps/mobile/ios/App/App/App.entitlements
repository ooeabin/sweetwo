<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱 링크(초대 https://sweetwo.kr/i/코드, 알림 메일 /n·/n/settings). 웹사이트 /.well-known/apple-app-site-association과 짝.
	     Apple Team ID가 있어야 동작함: docs/spec/34-launch-prep.md ‘출시 전 할 일’ 참고 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sweetwo.kr</string>
	</array>
	<!-- 홈 화면 위젯(26)과 값을 나누는 App Group. 위젯 확장(SweetwoWidget.entitlements)과 같은 이름 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.kr.sweetwo.app</string>
	</array>
</dict>
</plist>
